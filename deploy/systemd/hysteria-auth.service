[Unit]
Description=Hysteria2 Auth Service (Laravel 11 + Filament)
Documentation=https://github.com/getthelostcode/hysteria-auth-service
After=network-online.target redis-server.service
Wants=network-online.target
Requires=redis-server.service

[Service]
Type=simple
User=hysteria-auth
Group=hysteria-auth
WorkingDirectory=/opt/hysteria-auth-service
ExecStart=/usr/bin/php artisan serve --host=127.0.0.1 --port=8000
Restart=always
RestartSec=2
# Hysteria 会成批打 /auth，这里给足文件描述符
LimitNOFILE=65535
Environment=APP_ENV=production
# 只读保护（写操作走 storage/ 与 database/）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/hysteria-auth-service/storage /opt/hysteria-auth-service/database

[Install]
WantedBy=multi-user.target
