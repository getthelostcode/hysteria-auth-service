APP_NAME="Hysteria Auth Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://auth.ipx.sarl
APP_LOCALE=zh_CN

# 生产 MySQL 8：DB_CONNECTION=mysql + DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD
# 本地/测试用 SQLite：
DB_CONNECTION=sqlite
DB_DATABASE=/opt/hysteria-auth-service/database/database.sqlite

SESSION_DRIVER=database
CACHE_STORE=redis
QUEUE_CONNECTION=sync

REDIS_PREFIX=
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

LOG_CHANNEL=daily

# 反代/隧道回源时必须配，否则审计 IP 全是 127.0.0.1
TRUSTED_PROXIES=127.0.0.1,::1

# ---- 鉴权服务参数 ----
AUTH_CACHE_PREFIX=hyauth
AUTH_CACHE_TTL=60
AUTH_PASSWORD_CACHE=false
ONLINE_TTL=90
AUTH_MAX_FAILURES_PER_MIN=20
AUTH_FAIL_BLOCK_SECONDS=60
AUTH_LOG_DENIALS=true

# 兼容上报面（留空则该接口关闭）
TRAFFIC_REPORT_TOKEN=

# 注册（面板里也能改）
REGISTRATION_ENABLED=false
REGISTRATION_REQUIRES_INVITE=true
REGISTRATION_MAX_PER_HOUR_PER_IP=3
REGISTRATION_MIN_PASSWORD=8

# 新用户默认
DEFAULT_QUOTA_BYTES=0
DEFAULT_VALID_DAYS=30
DEFAULT_MAX_DEVICES=3
